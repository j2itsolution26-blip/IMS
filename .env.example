# ---------------------------------------------------------------------------
# Database — Supabase Postgres
# ---------------------------------------------------------------------------
# DATABASE_URL uses the connection POOLER (port 6543) and must carry
# ?pgbouncer=true — serverless functions open many short-lived connections and
# will exhaust a direct pool otherwise.
#
# Size the pool for how the app is being run — this matters, and getting it
# wrong produces minute-long page loads rather than an obvious error:
#
#   Local dev / any long-running Node server:
#     &connection_limit=10&pool_timeout=20&connect_timeout=15
#     One process serves every request, and pages here run several aggregate
#     queries in parallel. A pool of 1 serialises them, and a pooler-side idle
#     reset wedges the process (P1017 "Server has closed the connection").
#
#   Vercel / serverless:
#     &connection_limit=1
#     Each invocation is its own short-lived process, so one connection each is
#     correct — a larger pool per invocation exhausts the pooler under load.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20&connect_timeout=15"

# DIRECT_URL bypasses the pooler (port 5432). Prisma Migrate needs it because
# migrations require a session-level connection that PgBouncer cannot provide.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Authentication — Better Auth
# ---------------------------------------------------------------------------
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""

# Public origin of the deployment. Optional on Vercel (VERCEL_URL is used),
# but set it explicitly for a custom domain so auth callbacks resolve correctly.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Storage — Supabase Storage (product images)
# ---------------------------------------------------------------------------
# Optional. Without these the app runs normally, but product photos cannot be
# uploaded. All values come from Supabase → Project Settings → API Keys, for
# the SAME project as DATABASE_URL above.
#
# The bucket is created automatically on the first upload; it does not need to
# exist beforehand.
#
# If the URL is left blank, wrong, or stale, it is derived from DATABASE_URL —
# storage and the database are one project, so the connection string that is
# demonstrably working is treated as the authority on which project that is.
SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Browser-safe. Nothing reads it today (this app only talks to Supabase from
# the server), so it is optional.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# SERVER-ONLY — this key bypasses row level security.
#   * never give it a NEXT_PUBLIC_ prefix (Next inlines those into the browser bundle)
#   * never commit a real value
#   * on Vercel, add it WITHOUT ticking any "expose to browser" option
# `SUPABASE_SERVICE_ROLE_KEY` is the legacy name and still works.
SUPABASE_SECRET_KEY=""

SUPABASE_STORAGE_BUCKET="product-images"
