# ---------------------------------------------------------------------------
# Database — Supabase Postgres
# ---------------------------------------------------------------------------
# DATABASE_URL uses the connection POOLER (port 6543) and must carry
# ?pgbouncer=true — serverless functions open many short-lived connections and
# will exhaust a direct pool otherwise.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL bypasses the pooler (port 5432). Prisma Migrate needs it because
# migrations require a session-level connection that PgBouncer cannot provide.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Authentication — Better Auth
# ---------------------------------------------------------------------------
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""

# Public origin of the deployment. Optional on Vercel (VERCEL_URL is used),
# but set it explicitly for a custom domain so auth callbacks resolve correctly.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Storage — Supabase Storage (product images)
# ---------------------------------------------------------------------------
# Optional. Without these the app runs normally; the image upload button is
# replaced by a plain URL field.
#
# Create a PUBLIC bucket named `product-images` in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Never expose this to the browser — it bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"
