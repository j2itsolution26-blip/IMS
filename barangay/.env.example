# PostgreSQL connection string (Supabase, Neon, or a local server).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/barangay?schema=public"

# One-time secret for the first-run /setup page, which creates the
# Punong Barangay (captain) account. Set it, finish setup, then remove it.
SETUP_TOKEN="change-me-to-a-long-random-string"

# Public base URL, printed inside each certificate's QR code so anyone can
# check it at /verify/<code>. No trailing slash.
APP_URL="https://your-barangay-app.vercel.app"
