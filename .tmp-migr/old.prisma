// Simple POS + Inventory — data model for a small sari-sari/convenience store.
//
// Design notes:
//  * Money is Decimal(18,4) everywhere. Never Float.
//  * Every product is counted and sold by the piece. There are no units of
//    measure. Quantity columns keep their Decimal(18,3) storage type, but CHECK
//    constraints (migration 20261019090000) hold them to whole numbers.
//  * `Inventory` is the single source of truth for on-hand stock and is only ever
//    mutated inside a transaction that also writes an `InventoryTransaction` row.
//    The ledger and the balance can therefore never drift.
//  * This is a single-location system. Exactly one `Warehouse` row is seeded and
//    every operation resolves it silently server-side — there is no location
//    picker anywhere in the UI. The model is kept (rather than removed) so the
//    stock-ledger engine below needs no changes to its signatures.
//  * There is no Customer model. Every sale is a walk-in sale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity & access control
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  // Sign-in name, stored trimmed and lowercase so uniqueness is
  // case-insensitive (a CHECK constraint in migration 20261020090000 holds
  // it to that form). `displayUsername` keeps the capitalisation as typed.
  username        String  @unique
  displayUsername String?
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  // Hash of the POS lock-screen PIN (same hasher as passwords). Optional: with
  // no PIN the lock screen asks for the account password.
  posPinHash    String?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  sessions             Session[]
  accounts             Account[]
  auditLogs            AuditLog[]
  sales                Sale[]
  inventoryTransaction InventoryTransaction[]
  returns              Return[]
  payments             Payment[]
  shifts               CashierShift[] @relation("ShiftCashier")
  closedShifts         CashierShift[] @relation("ShiftClosedBy")
  reviewedShifts       CashierShift[] @relation("ShiftReviewedBy")
  cashMovements        CashMovement[]
  shiftAdjustments     ShiftAdjustment[]
  readNotifications    Notification[] @relation("NotificationReadBy")
  passkeys             Passkey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  isSystem    Boolean @default(false)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  // "products.create", "reports.view" — resource.action
  key         String  @unique
  resource    String
  action      String
  description String?

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Better Auth session/credential tables.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  // Set while the POS lock screen is up. A locked session stays signed in but
  // every page and server action refuses it until it is unlocked.
  lockedAt       DateTime?
  // Wrong PIN/password attempts on the lock screen since it was last unlocked.
  unlockFailures Int       @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// A WebAuthn passkey: the public half only. The private key never leaves the
// user's device or passkey provider, and no biometric data ever reaches the
// server — the device checks the face or fingerprint itself and signs.
model Passkey {
  id           String  @id @default(cuid())
  // Base64url credential id, as the authenticator reports it.
  credentialId String  @unique
  // COSE public key, base64url. Verifies each sign-in signature.
  publicKey    String
  // Signature counter; 0 for authenticators that do not keep one.
  counter      Int     @default(0)
  // Comma-separated WebAuthn transports (internal, hybrid, usb, …).
  transports   String?
  // 'singleDevice' or 'multiDevice' (synced, e.g. iCloud Keychain).
  deviceType   String
  backedUp     Boolean @default(false)
  // Authenticator model id; often all zeros for privacy.
  aaguid       String?
  // Shown in the profile so the owner can tell their devices apart.
  name         String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("passkeys")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  // Self-relation so categories can nest (Beverages > Soft Drinks).
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String  @id @default(cuid())
  sku         String  @unique
  barcode     String? @unique
  name        String
  description String?
  imageUrl    String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // costPrice is the moving-average cost, recalculated on every stock-in.
  costPrice    Decimal @default(0) @db.Decimal(18, 4)
  sellingPrice Decimal @default(0) @db.Decimal(18, 4)

  minStock     Decimal @default(0) @db.Decimal(18, 3)
  maxStock     Decimal @default(0) @db.Decimal(18, 3)
  reorderLevel Decimal @default(0) @db.Decimal(18, 3)
  reorderQty   Decimal @default(0) @db.Decimal(18, 3)

  status      ProductStatus @default(ACTIVE)
  isTrackable Boolean       @default(true)

  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  saleItems             SaleItem[]
  returnItems           ReturnItem[]
  priceHistory          PriceHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([name])
  @@map("products")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Price changes are auditable and drive the "Price Changed" notification.
model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  field    PriceField
  oldValue Decimal    @db.Decimal(18, 4)
  newValue Decimal    @db.Decimal(18, 4)
  changedBy String?
  createdAt DateTime  @default(now())

  @@index([productId, createdAt])
  @@map("price_history")
}

enum PriceField {
  COST
  SELLING
}

// ---------------------------------------------------------------------------
// Location
// ---------------------------------------------------------------------------

// Single-location system: exactly one row is seeded and used everywhere.
// Kept as its own table (rather than removed) so the stock-ledger engine
// below needs no changes — see the file-level note at the top.
model Warehouse {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  address   String?
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  sales                 Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warehouses")
}

// ---------------------------------------------------------------------------
// Stock
// ---------------------------------------------------------------------------

// One row per product per warehouse. `quantity` is on-hand; `reserved` is
// committed to unfulfilled orders. Available = quantity - reserved.
model Inventory {
  id          String @id @default(cuid())
  productId   String
  warehouseId String

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  quantity Decimal @default(0) @db.Decimal(18, 3)
  reserved Decimal @default(0) @db.Decimal(18, 3)

  // Drives inventory-aging and dead-stock reports.
  lastReceivedAt DateTime?
  lastSoldAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("inventory")
}

// Append-only stock ledger. Every movement in the system lands here.
model InventoryTransaction {
  id          String @id @default(cuid())
  productId   String
  warehouseId String

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  type InventoryTransactionType

  // Signed: positive adds stock, negative removes it.
  quantity      Decimal @db.Decimal(18, 3)
  balanceBefore Decimal @db.Decimal(18, 3)
  balanceAfter  Decimal @db.Decimal(18, 3)
  // Unit cost at the moment of the movement — used for COGS and stock value.
  unitCost      Decimal @default(0) @db.Decimal(18, 4)

  // Polymorphic pointer back to whatever caused the movement.
  referenceType ReferenceType?
  referenceId   String?
  note          String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([type, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

enum InventoryTransactionType {
  STOCK_IN
  SALE
  SALE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  OPENING_BALANCE
}

enum ReferenceType {
  SALE
  RETURN
  ADJUSTMENT
}

// ---------------------------------------------------------------------------
// Cashier shifts
// ---------------------------------------------------------------------------

// One shift per cashier session. Opens with a counted starting float, closes
// with a counted cash total; the difference is the till variance. Totals are
// computed live while the shift is open, then frozen onto this row at close
// so a later void/return can never silently rewrite a reconciled shift.
model CashierShift {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("ShiftCashier", fields: [userId], references: [id], onDelete: Restrict)

  status       ShiftStatus @default(OPEN)
  openedAt     DateTime    @default(now())
  openingCash  Decimal     @db.Decimal(18, 4)
  // Denominations, coins for change, anything noticed when counting the float.
  openingNotes String?

  closedAt         DateTime?
  expectedCash     Decimal?  @db.Decimal(18, 4)
  actualCash       Decimal?  @db.Decimal(18, 4)
  difference       Decimal?  @db.Decimal(18, 4)
  totalSales       Decimal?  @db.Decimal(18, 4)
  transactionCount Int?
  // The parts of expectedCash, frozen at close alongside it.
  cashSales        Decimal?  @db.Decimal(18, 4)
  cashRefunds      Decimal?  @db.Decimal(18, 4)
  cashIn           Decimal?  @db.Decimal(18, 4)
  cashOut          Decimal?  @db.Decimal(18, 4)
  // Who closed it: the cashier, or the owner closing a shift left open.
  closedById       String?
  closedBy         User?     @relation("ShiftClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  // Closing notes.
  notes String?

  // Human-facing reference, shown as SH-000123. Assigned by the database.
  number Int @unique @default(autoincrement())

  // Owner review of a closed shift whose count missed the expected cash by
  // more than the tolerance. Reviewing records who looked and what they
  // concluded; it never changes the count or the variance above.
  reviewStatus ShiftReviewStatus @default(NOT_REQUIRED)
  reviewedById String?
  reviewedBy   User?             @relation("ShiftReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  sales         Sale[]
  payments      Payment[]
  movements     CashMovement[]
  adjustments   ShiftAdjustment[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Also, from the migrations: a partial unique index allows one OPEN shift
  // per cashier, and a trigger refuses changes to a closed shift's figures.
  @@index([userId, status])
  @@index([status])
  @@index([closedAt])
  @@index([reviewStatus])
  @@map("cashier_shifts")
}

enum ShiftReviewStatus {
  // Open, or closed within the tolerance.
  NOT_REQUIRED
  // Closed short or over; waiting for the owner.
  PENDING
  REVIEWED
}

// A correction to a closed shift's reconciliation, made by the owner — money
// found later, a miscount confirmed. Signed: positive adds to the counted
// cash, negative takes from it. Kept beside the original figures rather than
// rewriting them, and append-only (a trigger refuses updates and deletes).
model ShiftAdjustment {
  id      String       @id @default(cuid())
  shiftId String
  shift   CashierShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  amount  Decimal      @db.Decimal(18, 4)
  reason  String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([shiftId])
  @@map("shift_adjustments")
}

// In-app notices for the owner. One shared inbox: anyone holding the
// financial permission sees them. `dedupeKey` is unique, so a retried request
// or a repeated poll cannot raise the same notice twice.
model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String
  href      String?
  dedupeKey String           @unique

  shiftId String?
  shift   CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  readAt   DateTime?
  readById String?
  readBy   User?     @relation("NotificationReadBy", fields: [readById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([readAt, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  SHIFT_OPENED
  SHIFT_CLOSED
  SHIFT_SHORTAGE
  SHIFT_OVERAGE
  SHIFT_OVERDUE
}

// Cash put into or taken out of a drawer during a shift for anything other
// than a sale or refund — more change, a supplier paid from the till, a bank
// drop. Append-only: a mistake is corrected with an opposite movement.
model CashMovement {
  id      String           @id @default(cuid())
  shiftId String
  shift   CashierShift     @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  type    CashMovementType
  // Always positive; `type` gives the direction.
  amount  Decimal          @db.Decimal(18, 4)
  reason  String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([shiftId])
  @@map("cash_movements")
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
}

enum ShiftStatus {
  OPEN
  CLOSED
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

model Sale {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  warehouseId String
  userId      String
  shiftId     String?

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  shift     CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  status  SaleStatus  @default(COMPLETED)
  channel SaleChannel @default(POS)

  subtotal    Decimal @default(0) @db.Decimal(18, 4)
  taxAmount   Decimal @default(0) @db.Decimal(18, 4)
  discount    Decimal @default(0) @db.Decimal(18, 4)
  total       Decimal @default(0) @db.Decimal(18, 4)
  paidAmount  Decimal @default(0) @db.Decimal(18, 4)
  changeAmount Decimal @default(0) @db.Decimal(18, 4)
  // Sum of (unitCost * qty) frozen at sale time, so profit never drifts when
  // product cost changes later.
  costOfGoods Decimal @default(0) @db.Decimal(18, 4)

  notes String?

  items    SaleItem[]
  payments Payment[]
  returns  Return[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status])
  @@index([shiftId])
  @@map("sales")
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
  VOIDED
}

enum SaleChannel {
  POS
  MANUAL
}

model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  productId String

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity         Decimal @db.Decimal(18, 3)
  returnedQuantity Decimal @default(0) @db.Decimal(18, 3)
  unitPrice        Decimal @db.Decimal(18, 4)
  unitCost         Decimal @db.Decimal(18, 4)
  discount         Decimal @default(0) @db.Decimal(18, 4)
  total            Decimal @db.Decimal(18, 4)

  returnItems ReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// ---------------------------------------------------------------------------
// Money in / out
// ---------------------------------------------------------------------------

model Payment {
  id            String @id @default(cuid())
  paymentNumber String @unique

  direction PaymentDirection
  method    PaymentMethod
  amount    Decimal          @db.Decimal(18, 4)
  reference String?
  note      String?

  saleId   String?
  returnId String?

  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  return Return? @relation(fields: [returnId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // The drawer this money went into or came out of. Set when the payment is
  // made; a cash refund paid with no open shift has none and is reported as
  // outside a shift.
  shiftId String?
  shift   CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([returnId])
  @@index([shiftId])
  @@index([createdAt])
  @@index([method, createdAt])
  @@map("payments")
}

enum PaymentDirection {
  INBOUND
  OUTBOUND
}

enum PaymentMethod {
  CASH
  GCASH
  CARD
  OTHER
}

// ---------------------------------------------------------------------------
// Returns
// ---------------------------------------------------------------------------

model Return {
  id           String @id @default(cuid())
  returnNumber String @unique

  status ReturnStatus @default(COMPLETED)

  saleId String?
  userId String

  sale Sale? @relation(fields: [saleId], references: [id], onDelete: SetNull)
  user User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  reason      String?
  subtotal    Decimal @default(0) @db.Decimal(18, 4)
  total       Decimal @default(0) @db.Decimal(18, 4)
  // Returned goods that cannot be resold do not go back into sellable stock.
  restock     Boolean @default(true)

  items    ReturnItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([saleId])
  @@map("returns")
}

enum ReturnStatus {
  PENDING
  COMPLETED
  REJECTED
}

model ReturnItem {
  id         String @id @default(cuid())
  returnId   String
  productId  String
  saleItemId String?

  return   Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  saleItem SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: SetNull)

  quantity  Decimal @db.Decimal(18, 3)
  unitPrice Decimal @db.Decimal(18, 4)
  unitCost  Decimal @default(0) @db.Decimal(18, 4)
  total     Decimal @db.Decimal(18, 4)

  @@index([returnId])
  @@index([productId])
  @@map("return_items")
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

model AuditLog {
  id     String      @id @default(cuid())
  action AuditAction
  entity String
  entityId String?
  summary  String

  // Field-level before/after diff.
  changes Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action])
  @@map("audit_logs")
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  INVENTORY_CHANGE
  PRICE_CHANGE
  SALE
  RETURN
  SETTINGS_CHANGE
  EXPORT
  SHIFT_OPEN
  SHIFT_CLOSE
  CASH_MOVEMENT
  SHIFT_REVIEW
  SHIFT_ADJUSTMENT
}

// Key/value app configuration. Typed by `type` so the settings UI can render
// the right control without a schema migration per setting.
model Setting {
  id          String      @id @default(cuid())
  key         String      @unique
  value       String
  type        SettingType @default(STRING)
  group       String      @default("general")
  label       String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("settings")
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}
