  SHIFT_ADJUSTMENT
  SUBSCRIPTION
  PAYMENT
}

// Key/value app configuration. Typed by `type` so the settings UI can render
// the right control without a schema migration per setting.
model Setting {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId     String      @default(dbgenerated())
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  key         String
  value       String
  type        SettingType @default(STRING)
  group       String      @default("general")
  label       String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, key])
  @@index([group])
  @@index([storeId])
  @@map("settings")
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}
