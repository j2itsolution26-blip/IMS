// Simple POS + Inventory — data model for a small sari-sari/convenience store.
//
// Design notes:
//  * Money is Decimal(18,4) everywhere. Never Float. Quantities are Decimal(18,3)
//    so fractional units (kg, litre) work without a second code path.
//  * `Inventory` is the single source of truth for on-hand stock and is only ever
//    mutated inside a transaction that also writes an `InventoryTransaction` row.
//    The ledger and the balance can therefore never drift.
//  * This is a single-location system. Exactly one `Warehouse` row is seeded and
//    every operation resolves it silently server-side — there is no location
//    picker anywhere in the UI. The model is kept (rather than removed) so the
//    stock-ledger engine below needs no changes to its signatures.
//  * There is no Customer model. Every sale is a walk-in sale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity & access control
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  sessions             Session[]
  accounts             Account[]
  auditLogs            AuditLog[]
  sales                Sale[]
  inventoryTransaction InventoryTransaction[]
  returns              Return[]
  payments             Payment[]
  shifts               CashierShift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  isSystem    Boolean @default(false)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  // "products.create", "reports.view" — resource.action
  key         String  @unique
  resource    String
  action      String
  description String?

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Better Auth session/credential tables.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  // Self-relation so categories can nest (Beverages > Soft Drinks).
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Unit {
  id           String  @id @default(cuid())
  name         String  @unique
  abbreviation String  @unique
  // 1 for base units; a "Case of 24" would be 24.
  factor       Decimal @default(1) @db.Decimal(18, 4)
  allowDecimal Boolean @default(false)
  isActive     Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("units")
}

model Product {
  id          String  @id @default(cuid())
  sku         String  @unique
  barcode     String? @unique
  name        String
  description String?
  imageUrl    String?

  categoryId String
  unitId     String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  // costPrice is the moving-average cost, recalculated on every stock-in.
  costPrice    Decimal @default(0) @db.Decimal(18, 4)
  sellingPrice Decimal @default(0) @db.Decimal(18, 4)

  minStock     Decimal @default(0) @db.Decimal(18, 3)
  maxStock     Decimal @default(0) @db.Decimal(18, 3)
  reorderLevel Decimal @default(0) @db.Decimal(18, 3)
  reorderQty   Decimal @default(0) @db.Decimal(18, 3)

  status      ProductStatus @default(ACTIVE)
  isTrackable Boolean       @default(true)

  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  saleItems             SaleItem[]
  returnItems           ReturnItem[]
  priceHistory          PriceHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([name])
  @@map("products")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Price changes are auditable and drive the "Price Changed" notification.
model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  field    PriceField
  oldValue Decimal    @db.Decimal(18, 4)
  newValue Decimal    @db.Decimal(18, 4)
  changedBy String?
  createdAt DateTime  @default(now())

  @@index([productId, createdAt])
  @@map("price_history")
}

enum PriceField {
  COST
  SELLING
}

// ---------------------------------------------------------------------------
// Location
// ---------------------------------------------------------------------------

// Single-location system: exactly one row is seeded and used everywhere.
// Kept as its own table (rather than removed) so the stock-ledger engine
// below needs no changes — see the file-level note at the top.
model Warehouse {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  address   String?
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  sales                 Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warehouses")
}

// ---------------------------------------------------------------------------
// Stock
// ---------------------------------------------------------------------------

// One row per product per warehouse. `quantity` is on-hand; `reserved` is
// committed to unfulfilled orders. Available = quantity - reserved.
model Inventory {
  id          String @id @default(cuid())
  productId   String
  warehouseId String

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  quantity Decimal @default(0) @db.Decimal(18, 3)
  reserved Decimal @default(0) @db.Decimal(18, 3)

  // Drives inventory-aging and dead-stock reports.
  lastReceivedAt DateTime?
  lastSoldAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("inventory")
}

// Append-only stock ledger. Every movement in the system lands here.
model InventoryTransaction {
  id          String @id @default(cuid())
  productId   String
  warehouseId String

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  type InventoryTransactionType

  // Signed: positive adds stock, negative removes it.
  quantity      Decimal @db.Decimal(18, 3)
  balanceBefore Decimal @db.Decimal(18, 3)
  balanceAfter  Decimal @db.Decimal(18, 3)
  // Unit cost at the moment of the movement — used for COGS and stock value.
  unitCost      Decimal @default(0) @db.Decimal(18, 4)

  // Polymorphic pointer back to whatever caused the movement.
  referenceType ReferenceType?
  referenceId   String?
  note          String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([type, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

enum InventoryTransactionType {
  STOCK_IN
  SALE
  SALE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  OPENING_BALANCE
}

enum ReferenceType {
  SALE
  RETURN
  ADJUSTMENT
}

// ---------------------------------------------------------------------------
// Cashier shifts
// ---------------------------------------------------------------------------

// One shift per cashier session. Opens with a counted starting float, closes
// with a counted cash total; the difference is the till variance. Totals are
// computed live while the shift is open, then frozen onto this row at close
// so a later void/return can never silently rewrite a reconciled shift.
model CashierShift {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  status      ShiftStatus @default(OPEN)
  openedAt    DateTime    @default(now())
  openingCash Decimal     @db.Decimal(18, 4)

  closedAt         DateTime?
  expectedCash     Decimal?  @db.Decimal(18, 4)
  actualCash       Decimal?  @db.Decimal(18, 4)
  difference       Decimal?  @db.Decimal(18, 4)
  totalSales       Decimal?  @db.Decimal(18, 4)
  transactionCount Int?

  notes String?

  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status])
  @@map("cashier_shifts")
}

enum ShiftStatus {
  OPEN
  CLOSED
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

model Sale {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  warehouseId String
  userId      String
  shiftId     String?

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  shift     CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  status  SaleStatus  @default(COMPLETED)
  channel SaleChannel @default(POS)

  subtotal    Decimal @default(0) @db.Decimal(18, 4)
  taxAmount   Decimal @default(0) @db.Decimal(18, 4)
  discount    Decimal @default(0) @db.Decimal(18, 4)
  total       Decimal @default(0) @db.Decimal(18, 4)
  paidAmount  Decimal @default(0) @db.Decimal(18, 4)
  changeAmount Decimal @default(0) @db.Decimal(18, 4)
  // Sum of (unitCost * qty) frozen at sale time, so profit never drifts when
  // product cost changes later.
  costOfGoods Decimal @default(0) @db.Decimal(18, 4)

  notes String?

  items    SaleItem[]
  payments Payment[]
  returns  Return[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status])
  @@index([shiftId])
  @@map("sales")
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
  VOIDED
}

enum SaleChannel {
  POS
  MANUAL
}

model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  productId String

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity         Decimal @db.Decimal(18, 3)
  returnedQuantity Decimal @default(0) @db.Decimal(18, 3)
  unitPrice        Decimal @db.Decimal(18, 4)
  unitCost         Decimal @db.Decimal(18, 4)
  discount         Decimal @default(0) @db.Decimal(18, 4)
  total            Decimal @db.Decimal(18, 4)

  returnItems ReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// ---------------------------------------------------------------------------
// Money in / out
// ---------------------------------------------------------------------------

model Payment {
  id            String @id @default(cuid())
  paymentNumber String @unique

  direction PaymentDirection
  method    PaymentMethod
  amount    Decimal          @db.Decimal(18, 4)
  reference String?
  note      String?

  saleId   String?
  returnId String?

  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  return Return? @relation(fields: [returnId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([returnId])
  @@index([createdAt])
  @@index([method, createdAt])
  @@map("payments")
}

enum PaymentDirection {
  INBOUND
  OUTBOUND
}

enum PaymentMethod {
  CASH
  GCASH
  CARD
  OTHER
}

// ---------------------------------------------------------------------------
// Returns
// ---------------------------------------------------------------------------

model Return {
  id           String @id @default(cuid())
  returnNumber String @unique

  status ReturnStatus @default(COMPLETED)

  saleId String?
  userId String

  sale Sale? @relation(fields: [saleId], references: [id], onDelete: SetNull)
  user User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  reason      String?
  subtotal    Decimal @default(0) @db.Decimal(18, 4)
  total       Decimal @default(0) @db.Decimal(18, 4)
  // Returned goods that cannot be resold do not go back into sellable stock.
  restock     Boolean @default(true)

  items    ReturnItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([saleId])
  @@map("returns")
}

enum ReturnStatus {
  PENDING
  COMPLETED
  REJECTED
}

model ReturnItem {
  id         String @id @default(cuid())
  returnId   String
  productId  String
  saleItemId String?

  return   Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  saleItem SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: SetNull)

  quantity  Decimal @db.Decimal(18, 3)
  unitPrice Decimal @db.Decimal(18, 4)
  unitCost  Decimal @default(0) @db.Decimal(18, 4)
  total     Decimal @db.Decimal(18, 4)

  @@index([returnId])
  @@index([productId])
  @@map("return_items")
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

model AuditLog {
  id     String      @id @default(cuid())
  action AuditAction
  entity String
  entityId String?
  summary  String

  // Field-level before/after diff.
  changes Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action])
  @@map("audit_logs")
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  INVENTORY_CHANGE
  PRICE_CHANGE
  SALE
  RETURN
  SETTINGS_CHANGE
  EXPORT
}

// Key/value app configuration. Typed by `type` so the settings UI can render
// the right control without a schema migration per setting.
model Setting {
  id          String      @id @default(cuid())
  key         String      @unique
  value       String
  type        SettingType @default(STRING)
  group       String      @default("general")
  label       String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("settings")
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}
