// Simple POS + Inventory — data model for a small sari-sari/convenience store.
//
// Design notes:
//  * Money is Decimal(18,4) everywhere. Never Float.
//  * Every product is counted and sold by the piece. There are no units of
//    measure. Quantity columns keep their Decimal(18,3) storage type, but CHECK
//    constraints (migration 20261019090000) hold them to whole numbers.
//  * `Inventory` is the single source of truth for on-hand stock and is only ever
//    mutated inside a transaction that also writes an `InventoryTransaction` row.
//    The ledger and the balance can therefore never drift.
//  * Multi-store: every business row belongs to a `Store` (see below). Each
//    store is a single location: exactly one `Warehouse` row per store is
//    seeded and every operation resolves it silently server-side — there is no location
//    picker anywhere in the UI. The model is kept (rather than removed) so the
//    stock-ledger engine below needs no changes to its signatures.
//  * There is no Customer model. Every sale is a walk-in sale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Stores (tenants)
// ---------------------------------------------------------------------------

// One business on the platform. Every store-owned row carries `storeId`, and
// application code only ever reaches those rows through the store-scoped
// client in src/lib/tenant, which adds the store to every query. Database
// triggers (migration 20261023090000) also refuse a row that points at a row
// of another store, so the two can never be linked even by a bug.
model Store {
  id   String @id @default(cuid())
  name String
  // URL-safe handle, unique across the platform.
  slug String @unique

  // The account that owns the store. Set once the owner exists.
  ownerId String? @unique
  owner   User?   @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  plan             StorePlan   @default(BASIC)
  status           StoreStatus @default(TRIAL)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?

  // The plan's quotas, copied here from src/lib/plans.ts whenever the plan or
  // status changes, so a database trigger can enforce them atomically. Null
  // means unlimited.
  productLimit Int?
  staffLimit   Int?

  members               User[]                 @relation("StoreMembers")
  roles                 Role[]
  categories            Category[]
  products              Product[]
  priceHistory          PriceHistory[]
  warehouses            Warehouse[]
  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  shifts                CashierShift[]
  shiftAdjustments      ShiftAdjustment[]
  notifications         Notification[]
  cashMovements         CashMovement[]
  sales                 Sale[]
  saleItems             SaleItem[]
  payments              Payment[]
  returns               Return[]
  returnItems           ReturnItem[]
  auditLogs             AuditLog[]
  settings              Setting[]
  usage                 StoreUsage[]
  subscriptionPayments  SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("stores")
}

// Metered use of a plan feature in one period (e.g. background removals in
// "2026-10"). Incremented atomically against the plan's quota.
model StoreUsage {
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  metric  String
  period  String
  count   Int    @default(0)

  updatedAt DateTime @updatedAt

  @@id([storeId, metric, period])
  @@map("store_usage")
}

enum InstallationStatus {
  IN_PROGRESS
  COMPLETED
}

// Whether this installation's first-time setup has been done: one row, ever
// (a CHECK in migration 20261027090000 pins the id to 1). Setup is open only
// while there is no COMPLETED row and no account at all; the row is never
// removed, so disabling or deleting an administrator later does not reopen it.
model Installation {
  id            Int                @id @default(1)
  status        InstallationStatus
  // A claim taken by one setup request while it creates the administrator.
  claimToken    String?
  claimedAt     DateTime?
  completedAt   DateTime?
  completedById String?
  completedBy   User?              @relation("InstallationCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@map("installation")
}

enum SubscriptionPaymentMethod {
  GCASH
  BANK_TRANSFER
  OTHER
}

// A subscription payment the platform administrator confirmed by hand (GCash
// or bank transfer received outside the app). Written only by the platform;
// a store can read its own. Permanent: a trigger (migration 20261026090000)
// refuses edits and deletes, except voiding an entry once, with a reason.
model SubscriptionPayment {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  plan        StorePlan
  amount      Decimal                   @db.Decimal(12, 2)
  currency    String                    @default("PHP")
  method      SubscriptionPaymentMethod
  // The GCash or bank reference, normalised (trimmed, uppercase, no spaces):
  // the same transfer can never be recorded twice.
  reference   String
  paidAt      DateTime
  // The subscription time this payment bought.
  months      Int
  periodStart DateTime
  periodEnd   DateTime
  notes       String?

  recordedById String
  recordedBy   User   @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason String?

  createdAt DateTime @default(now())

  @@unique([method, reference])
  @@index([storeId, createdAt])
  @@map("subscription_payments")
}

enum StorePlan {
  BASIC
  BUSINESS
  ENTERPRISE
}

enum StoreStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
}

// ---------------------------------------------------------------------------
// Identity & access control
// ---------------------------------------------------------------------------

model User {
  id String @id @default(cuid())

  // The store this account works in. Empty only for the platform's system
  // administrators, who hold no store permissions. Migration 20261023090000
  // keeps a user's store equal to their role's, and only the System
  // Administrator role has none.
  storeId         String?
  store           Store?    @relation("StoreMembers", fields: [storeId], references: [id], onDelete: Restrict)
  ownedStore      Store?    @relation("StoreOwner")
  name            String
  email           String    @unique
  // Sign-in name, stored trimmed and lowercase so uniqueness is
  // case-insensitive (a CHECK constraint in migration 20261020090000 holds
  // it to that form). `displayUsername` keeps the capitalisation as typed.
  username        String    @unique
  displayUsername String?
  emailVerified   Boolean   @default(false)
  image           String?
  phone           String?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  // Hash of the POS lock-screen PIN (same hasher as passwords). Optional: with
  // no PIN the lock screen asks for the account password.
  posPinHash      String?
  // Set by the server when an administrator chose this account's password
  // (a new store owner, or an owner password reset). While true, every page,
  // action and store query is refused except changing the password — see
  // `getCurrentUser`. Cleared only by that change, in the same transaction
  // that stores the new hash. Never accepted from client input.
  mustChangePassword Boolean @default(false)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  sessions             Session[]
  accounts             Account[]
  auditLogs            AuditLog[]
  sales                Sale[]
  inventoryTransaction InventoryTransaction[]
  returns              Return[]
  payments             Payment[]
  shifts               CashierShift[]         @relation("ShiftCashier")
  closedShifts         CashierShift[]         @relation("ShiftClosedBy")
  reviewedShifts       CashierShift[]         @relation("ShiftReviewedBy")
  cashMovements        CashMovement[]
  shiftAdjustments     ShiftAdjustment[]
  readNotifications    Notification[]         @relation("NotificationReadBy")
  passkeys             Passkey[]
  recordedPayments     SubscriptionPayment[]  @relation("PaymentRecordedBy")
  voidedPayments       SubscriptionPayment[]  @relation("PaymentVoidedBy")
  completedSetup       Installation[]         @relation("InstallationCompletedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([isActive])
  @@index([storeId])
  @@map("users")
}

model Role {
  id String @id @default(cuid())

  // Each store has its own copy of the built-in roles, so one owner editing
  // "Cashier" never changes another store's cashiers. Empty only for the
  // global System Administrator role.
  storeId     String?
  store       Store?  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name        String
  slug        String
  description String?
  isSystem    Boolean @default(false)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@unique([storeId, name])
  @@index([storeId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  // "products.create", "reports.view" — resource.action
  key         String  @unique
  resource    String
  action      String
  description String?

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Better Auth session/credential tables.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  // Set while the POS lock screen is up. A locked session stays signed in but
  // every page and server action refuses it until it is unlocked.
  lockedAt       DateTime?
  // Wrong PIN/password attempts on the lock screen since it was last unlocked.
  unlockFailures Int       @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// A WebAuthn passkey: the public half only. The private key never leaves the
// user's device or passkey provider, and no biometric data ever reaches the
// server — the device checks the face or fingerprint itself and signs.
model Passkey {
  id           String  @id @default(cuid())
  // Base64url credential id, as the authenticator reports it.
  credentialId String  @unique
  // COSE public key, base64url. Verifies each sign-in signature.
  publicKey    String
  // Signature counter; 0 for authenticators that do not keep one.
  counter      Int     @default(0)
  // Comma-separated WebAuthn transports (internal, hybrid, usb, …).
  transports   String?
  // 'singleDevice' or 'multiDevice' (synced, e.g. iCloud Keychain).
  deviceType   String
  backedUp     Boolean @default(false)
  // Authenticator model id; often all zeros for privacy.
  aaguid       String?
  // Shown in the profile so the owner can tell their devices apart.
  name         String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("passkeys")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId     String  @default(dbgenerated())
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name        String
  slug        String
  description String?
  isActive    Boolean @default(true)

  // Self-relation so categories can nest (Beverages > Soft Drinks).
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, name])
  @@unique([storeId, slug])
  @@index([parentId])
  @@index([storeId])
  @@map("categories")
}

model Product {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId     String  @default(dbgenerated())
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  sku         String
  barcode     String?
  name        String
  description String?
  imageUrl    String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // costPrice is the moving-average cost, recalculated on every stock-in.
  costPrice    Decimal @default(0) @db.Decimal(18, 4)
  sellingPrice Decimal @default(0) @db.Decimal(18, 4)

  minStock     Decimal @default(0) @db.Decimal(18, 3)
  maxStock     Decimal @default(0) @db.Decimal(18, 3)
  reorderLevel Decimal @default(0) @db.Decimal(18, 3)
  reorderQty   Decimal @default(0) @db.Decimal(18, 3)

  status      ProductStatus @default(ACTIVE)
  isTrackable Boolean       @default(true)

  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  saleItems             SaleItem[]
  returnItems           ReturnItem[]
  priceHistory          PriceHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@index([categoryId])
  @@index([status])
  @@index([name])
  @@index([storeId])
  @@map("products")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Price changes are auditable and drive the "Price Changed" notification.
model PriceHistory {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId   String  @default(dbgenerated())
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  field     PriceField
  oldValue  Decimal    @db.Decimal(18, 4)
  newValue  Decimal    @db.Decimal(18, 4)
  changedBy String?
  createdAt DateTime   @default(now())

  @@index([productId, createdAt])
  @@index([storeId])
  @@map("price_history")
}

enum PriceField {
  COST
  SELLING
}

// ---------------------------------------------------------------------------
// Location
// ---------------------------------------------------------------------------

// Single-location system: exactly one row is seeded and used everywhere.
// Kept as its own table (rather than removed) so the stock-ledger engine
// below needs no changes — see the file-level note at the top.
model Warehouse {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId   String  @default(dbgenerated())
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  code      String
  name      String
  address   String?
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  sales                 Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, code])
  @@index([storeId])
  @@map("warehouses")
}

// ---------------------------------------------------------------------------
// Stock
// ---------------------------------------------------------------------------

// One row per product per warehouse. `quantity` is on-hand; `reserved` is
// committed to unfulfilled orders. Available = quantity - reserved.
model Inventory {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId     String @default(dbgenerated())
  store       Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  productId   String
  warehouseId String

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  quantity Decimal @default(0) @db.Decimal(18, 3)
  reserved Decimal @default(0) @db.Decimal(18, 3)

  // Drives inventory-aging and dead-stock reports.
  lastReceivedAt DateTime?
  lastSoldAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@index([storeId])
  @@map("inventory")
}

// Append-only stock ledger. Every movement in the system lands here.
model InventoryTransaction {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId     String @default(dbgenerated())
  store       Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  productId   String
  warehouseId String

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  type InventoryTransactionType

  // Signed: positive adds stock, negative removes it.
  quantity      Decimal @db.Decimal(18, 3)
  balanceBefore Decimal @db.Decimal(18, 3)
  balanceAfter  Decimal @db.Decimal(18, 3)
  // Unit cost at the moment of the movement — used for COGS and stock value.
  unitCost      Decimal @default(0) @db.Decimal(18, 4)

  // Polymorphic pointer back to whatever caused the movement.
  referenceType ReferenceType?
  referenceId   String?
  note          String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([type, createdAt])
  @@index([referenceType, referenceId])
  @@index([storeId, createdAt])
  @@map("inventory_transactions")
}

enum InventoryTransactionType {
  STOCK_IN
  SALE
  SALE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  OPENING_BALANCE
}

enum ReferenceType {
  SALE
  RETURN
  ADJUSTMENT
}

// ---------------------------------------------------------------------------
// Cashier shifts
// ---------------------------------------------------------------------------

// One shift per cashier session. Opens with a counted starting float, closes
// with a counted cash total; the difference is the till variance. Totals are
// computed live while the shift is open, then frozen onto this row at close
// so a later void/return can never silently rewrite a reconciled shift.
model CashierShift {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId String @default(dbgenerated())
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  userId  String
  user    User   @relation("ShiftCashier", fields: [userId], references: [id], onDelete: Restrict)

  status       ShiftStatus @default(OPEN)
  openedAt     DateTime    @default(now())
  openingCash  Decimal     @db.Decimal(18, 4)
  // Denominations, coins for change, anything noticed when counting the float.
  openingNotes String?

  closedAt         DateTime?
  expectedCash     Decimal?  @db.Decimal(18, 4)
  actualCash       Decimal?  @db.Decimal(18, 4)
  difference       Decimal?  @db.Decimal(18, 4)
  totalSales       Decimal?  @db.Decimal(18, 4)
  transactionCount Int?
  // The parts of expectedCash, frozen at close alongside it.
  cashSales        Decimal?  @db.Decimal(18, 4)
  cashRefunds      Decimal?  @db.Decimal(18, 4)
  cashIn           Decimal?  @db.Decimal(18, 4)
  cashOut          Decimal?  @db.Decimal(18, 4)
  // Who closed it: the cashier, or the owner closing a shift left open.
  closedById       String?
  closedBy         User?     @relation("ShiftClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  // Closing notes.
  notes String?

  // Human-facing reference, shown as SH-000123. Assigned by the database.
  number Int @unique @default(autoincrement())

  // Owner review of a closed shift whose count missed the expected cash by
  // more than the tolerance. Reviewing records who looked and what they
  // concluded; it never changes the count or the variance above.
  reviewStatus ShiftReviewStatus @default(NOT_REQUIRED)
  reviewedById String?
  reviewedBy   User?             @relation("ShiftReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  sales         Sale[]
  payments      Payment[]
  movements     CashMovement[]
  adjustments   ShiftAdjustment[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Also, from the migrations: a partial unique index allows one OPEN shift
  // per cashier, and a trigger refuses changes to a closed shift's figures.
  @@index([userId, status])
  @@index([status])
  @@index([closedAt])
  @@index([reviewStatus])
  @@index([storeId, status])
  @@map("cashier_shifts")
}

enum ShiftReviewStatus {
  // Open, or closed within the tolerance.
  NOT_REQUIRED
  // Closed short or over; waiting for the owner.
  PENDING
  REVIEWED
}

// A correction to a closed shift's reconciliation, made by the owner — money
// found later, a miscount confirmed. Signed: positive adds to the counted
// cash, negative takes from it. Kept beside the original figures rather than
// rewriting them, and append-only (a trigger refuses updates and deletes).
model ShiftAdjustment {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId String       @default(dbgenerated())
  store   Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  shiftId String
  shift   CashierShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  amount  Decimal      @db.Decimal(18, 4)
  reason  String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([shiftId])
  @@index([storeId])
  @@map("shift_adjustments")
}

// In-app notices for the owner. One shared inbox: anyone holding the
// financial permission sees them. `dedupeKey` is unique, so a retried request
// or a repeated poll cannot raise the same notice twice.
model Notification {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId   String           @default(dbgenerated())
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  type      NotificationType
  title     String
  body      String
  href      String?
  dedupeKey String

  shiftId String?
  shift   CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  readAt   DateTime?
  readById String?
  readBy   User?     @relation("NotificationReadBy", fields: [readById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([storeId, dedupeKey])
  @@index([readAt, createdAt])
  @@index([createdAt])
  @@index([storeId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  SHIFT_OPENED
  SHIFT_CLOSED
  SHIFT_SHORTAGE
  SHIFT_OVERAGE
  SHIFT_OVERDUE
}

// Cash put into or taken out of a drawer during a shift for anything other
// than a sale or refund — more change, a supplier paid from the till, a bank
// drop. Append-only: a mistake is corrected with an opposite movement.
model CashMovement {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId String           @default(dbgenerated())
  store   Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  shiftId String
  shift   CashierShift     @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  type    CashMovementType
  // Always positive; `type` gives the direction.
  amount  Decimal          @db.Decimal(18, 4)
  reason  String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([shiftId])
  @@index([storeId])
  @@map("cash_movements")
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
}

enum ShiftStatus {
  OPEN
  CLOSED
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

model Sale {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId       String @default(dbgenerated())
  store         Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  invoiceNumber String

  warehouseId String
  userId      String
  shiftId     String?

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  shift     CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  status  SaleStatus  @default(COMPLETED)
  channel SaleChannel @default(POS)

  subtotal     Decimal @default(0) @db.Decimal(18, 4)
  taxAmount    Decimal @default(0) @db.Decimal(18, 4)
  discount     Decimal @default(0) @db.Decimal(18, 4)
  total        Decimal @default(0) @db.Decimal(18, 4)
  paidAmount   Decimal @default(0) @db.Decimal(18, 4)
  changeAmount Decimal @default(0) @db.Decimal(18, 4)
  // Sum of (unitCost * qty) frozen at sale time, so profit never drifts when
  // product cost changes later.
  costOfGoods  Decimal @default(0) @db.Decimal(18, 4)

  notes String?

  items    SaleItem[]
  payments Payment[]
  returns  Return[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, invoiceNumber])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status])
  @@index([shiftId])
  @@index([storeId, createdAt])
  @@map("sales")
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
  VOIDED
}

enum SaleChannel {
  POS
  MANUAL
}

model SaleItem {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId   String @default(dbgenerated())
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  saleId    String
  productId String

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity         Decimal @db.Decimal(18, 3)
  returnedQuantity Decimal @default(0) @db.Decimal(18, 3)
  unitPrice        Decimal @db.Decimal(18, 4)
  unitCost         Decimal @db.Decimal(18, 4)
  discount         Decimal @default(0) @db.Decimal(18, 4)
  total            Decimal @db.Decimal(18, 4)

  returnItems ReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@index([storeId])
  @@map("sale_items")
}

// ---------------------------------------------------------------------------
// Money in / out
// ---------------------------------------------------------------------------

model Payment {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId       String @default(dbgenerated())
  store         Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  paymentNumber String

  direction PaymentDirection
  method    PaymentMethod
  amount    Decimal          @db.Decimal(18, 4)
  reference String?
  note      String?

  saleId   String?
  returnId String?

  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  return Return? @relation(fields: [returnId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // The drawer this money went into or came out of. Set when the payment is
  // made; a cash refund paid with no open shift has none and is reported as
  // outside a shift.
  shiftId String?
  shift   CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([storeId, paymentNumber])
  @@index([saleId])
  @@index([returnId])
  @@index([shiftId])
  @@index([createdAt])
  @@index([method, createdAt])
  @@index([storeId, createdAt])
  @@map("payments")
}

enum PaymentDirection {
  INBOUND
  OUTBOUND
}

enum PaymentMethod {
  CASH
  GCASH
  CARD
  OTHER
}

// ---------------------------------------------------------------------------
// Returns
// ---------------------------------------------------------------------------

model Return {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId      String @default(dbgenerated())
  store        Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  returnNumber String

  status ReturnStatus @default(COMPLETED)

  saleId String?
  userId String

  sale Sale? @relation(fields: [saleId], references: [id], onDelete: SetNull)
  user User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  reason   String?
  subtotal Decimal @default(0) @db.Decimal(18, 4)
  total    Decimal @default(0) @db.Decimal(18, 4)
  // Returned goods that cannot be resold do not go back into sellable stock.
  restock  Boolean @default(true)

  items    ReturnItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, returnNumber])
  @@index([createdAt])
  @@index([saleId])
  @@index([storeId, createdAt])
  @@map("returns")
}

enum ReturnStatus {
  PENDING
  COMPLETED
  REJECTED
}

model ReturnItem {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId    String  @default(dbgenerated())
  store      Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  returnId   String
  productId  String
  saleItemId String?

  return   Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  saleItem SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: SetNull)

  quantity  Decimal @db.Decimal(18, 3)
  unitPrice Decimal @db.Decimal(18, 4)
  unitCost  Decimal @default(0) @db.Decimal(18, 4)
  total     Decimal @db.Decimal(18, 4)

  @@index([returnId])
  @@index([productId])
  @@index([storeId])
  @@map("return_items")
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

model AuditLog {
  id String @id @default(cuid())

  // Store the entry belongs to. Empty for platform events (system
  // administrators managing stores), which no store can see.
  storeId  String?
  store    Store?      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  action   AuditAction
  entity   String
  entityId String?
  summary  String

  // Field-level before/after diff.
  changes Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action])
  @@index([storeId, createdAt])
  @@map("audit_logs")
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  INVENTORY_CHANGE
  PRICE_CHANGE
  SALE
  RETURN
  SETTINGS_CHANGE
  EXPORT
  SHIFT_OPEN
  SHIFT_CLOSE
  CASH_MOVEMENT
  SHIFT_REVIEW
  SHIFT_ADJUSTMENT
  SUBSCRIPTION
  PAYMENT
}

// Key/value app configuration. Typed by `type` so the settings UI can render
// the right control without a schema migration per setting.
model Setting {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId     String      @default(dbgenerated())
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  key         String
  value       String
  type        SettingType @default(STRING)
  group       String      @default("general")
  label       String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, key])
  @@index([group])
  @@index([storeId])
  @@map("settings")
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}
