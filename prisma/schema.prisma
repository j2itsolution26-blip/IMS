// Simple POS + Inventory — data model for a small sari-sari/convenience store.
//
// Design notes:
//  * Money is Decimal(18,4) everywhere. Never Float.
//  * Each product has one unit (piece, kg, m, …) and says whether it may be
//    sold in fractions of it. Quantities are Decimal(18,3) in that unit; a
//    trigger (migration 20261106090000) keeps them whole for products that do
//    not allow decimals.
//  * `Inventory` is the single source of truth for on-hand stock and is only ever
//    mutated inside a transaction that also writes an `InventoryTransaction` row.
//    The ledger and the balance can therefore never drift.
//  * Multi-store: every business row belongs to a `Store` (see below). Each
//    store is a single location: exactly one `Warehouse` row per store is
//    seeded and every operation resolves it silently server-side — there is no location
//    picker anywhere in the UI. The model is kept (rather than removed) so the
//    stock-ledger engine below needs no changes to its signatures.
//  * There is no Customer model. Every sale is a walk-in sale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Stores (tenants)
// ---------------------------------------------------------------------------

// One business on the platform. Every store-owned row carries `storeId`, and
// application code only ever reaches those rows through the store-scoped
// client in src/lib/tenant, which adds the store to every query. Database
// triggers (migration 20261023090000) also refuse a row that points at a row
// of another store, so the two can never be linked even by a bug.
model Store {
  id   String @id @default(cuid())
  name String
  // URL-safe handle, unique across the platform.
  slug String @unique

  // The account that owns the store. Set once the owner exists.
  ownerId String? @unique
  owner   User?   @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  plan             StorePlan        @default(BASIC)
  status           StoreStatus      @default(TRIAL)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  // The interval of the paid period in force, set when a payment for an
  // invoice is verified. Null during a trial or for legacy manual payments.
  billingInterval  BillingInterval?

  // The plan's quotas, copied here from src/lib/plans.ts whenever the plan or
  // status changes, so a database trigger can enforce them atomically. Null
  // means unlimited.
  productLimit Int?
  staffLimit   Int?

  members               User[]                       @relation("StoreMembers")
  roles                 Role[]
  categories            Category[]
  products              Product[]
  priceHistory          PriceHistory[]
  warehouses            Warehouse[]
  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  shifts                CashierShift[]
  shiftAdjustments      ShiftAdjustment[]
  notifications         Notification[]
  cashMovements         CashMovement[]
  sales                 Sale[]
  saleItems             SaleItem[]
  payments              Payment[]
  returns               Return[]
  returnItems           ReturnItem[]
  auditLogs             AuditLog[]
  settings              Setting[]
  usage                 StoreUsage[]
  subscriptionPayments  SubscriptionPayment[]
  paymentReceipts       SubscriptionPaymentReceipt[]
  invoices              Invoice[]
  supportTickets        SupportTicket[]
  walletTransactions    WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("stores")
}

// Metered use of a plan feature in one period (e.g. background removals in
// "2026-10"). Incremented atomically against the plan's quota.
model StoreUsage {
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  metric  String
  period  String
  count   Int    @default(0)

  updatedAt DateTime @updatedAt

  @@id([storeId, metric, period])
  @@map("store_usage")
}

enum InstallationStatus {
  IN_PROGRESS
  COMPLETED
}

// Whether this installation's first-time setup has been done: one row, ever
// (a CHECK in migration 20261027090000 pins the id to 1). Setup is open only
// while there is no COMPLETED row and no account at all; the row is never
// removed, so disabling or deleting an administrator later does not reopen it.
model Installation {
  id            Int                @id @default(1)
  status        InstallationStatus
  // A claim taken by one setup request while it creates the administrator.
  claimToken    String?
  claimedAt     DateTime?
  completedAt   DateTime?
  completedById String?
  completedBy   User?              @relation("InstallationCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@map("installation")
}

enum SubscriptionPaymentMethod {
  GCASH
  BANK_TRANSFER
  OTHER
}

// A subscription payment the platform administrator confirmed by hand (GCash
// or bank transfer received outside the app). Written only by the platform;
// a store can read its own. Permanent: a trigger (migration 20261026090000)
// refuses edits and deletes, except voiding an entry once, with a reason.
model SubscriptionPayment {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  plan        StorePlan
  amount      Decimal                   @db.Decimal(12, 2)
  currency    String                    @default("PHP")
  method      SubscriptionPaymentMethod
  // The GCash or bank reference, normalised (trimmed, uppercase, no spaces):
  // the same transfer can never be recorded twice. Unique per method among
  // payments that were not rejected (partial index, migration
  // 20261101090000), so corrected proof may repeat a rejected reference.
  reference   String
  paidAt      DateTime
  // The subscription time this payment bought. For an owner-submitted
  // payment the period is the invoice's until it is verified, then the
  // period actually bought from that moment (set in the same update).
  months      Int
  periodStart DateTime
  periodEnd   DateTime
  notes       String?

  recordedById String
  recordedBy   User   @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason String?

  // Owner-submitted payments start PENDING; only the platform administrator
  // verifies or rejects them, once (enforced by trigger, migration
  // 20261029090000). Payments the administrator records directly are
  // VERIFIED from the start. Only VERIFIED, non-void payments are revenue.
  status       SubscriptionPaymentStatus @default(VERIFIED)
  invoiceId    String?
  invoice      Invoice?                  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?                     @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  rejectedAt   DateTime?
  rejectedById String?
  rejectedBy   User?                     @relation("PaymentRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)
  rejectReason String?

  // The owner's proof of payment. Required for every owner submission from
  // migration 20261101090000 on (deferred trigger); manual payments have none.
  receipt SubscriptionPaymentReceipt?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([invoiceId])
  @@index([storeId, createdAt])
  @@map("subscription_payments")
}

// A receipt or screenshot an owner uploaded as proof of one payment. The file
// lives in a private bucket under a random name and is handed out only as a
// short-lived signed link, to that store's owner or a platform administrator.
// Append-only (trigger): a correction is a new payment with a new receipt.
// Reached only through the billing service (MODEL_SCOPES: denied).
model SubscriptionPaymentReceipt {
  id           String              @id @default(cuid())
  paymentId    String              @unique
  payment      SubscriptionPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  storeId      String
  store        Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  // Path inside the private bucket; a random name, never the uploaded one.
  storagePath  String              @unique
  originalName String
  // Taken from the file's own bytes, not from the browser.
  mimeType     String
  sizeBytes    Int
  // Lets the administrator see when the same image was sent for two payments.
  sha256       String
  uploadedById String
  uploadedBy   User                @relation("PaymentReceiptUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([sha256])
  @@map("subscription_payment_receipts")
}

enum SubscriptionPaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

// What a plan costs per billing interval. Set only by the platform
// administrator; there is no price until one is entered here. An invoice
// copies the amount, so changing a price never rewrites an issued invoice.
model PlanPrice {
  id          String          @id @default(cuid())
  plan        StorePlan
  interval    BillingInterval
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("PHP")
  updatedById String?
  updatedAt   DateTime        @updatedAt
  createdAt   DateTime        @default(now())

  @@unique([plan, interval])
  @@map("plan_prices")
}

// Billing terms an owner accepts when choosing a paid plan. Versions are
// append-only; the newest is current. Each invoice keeps the version and a
// copy of the text that was accepted.
model BillingTerms {
  id          String   @id @default(cuid())
  version     Int      @unique
  body        String
  createdById String?
  createdAt   DateTime @default(now())

  @@map("billing_terms")
}

// Platform-wide settings (e.g. payment instructions shown to owners). Not
// store data: stores never read this table directly.
model PlatformSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

// A payment obligation an owner agreed to by choosing a plan and accepting
// the billing terms. Amount, plan, period and terms are copied at that moment
// and cannot change (trigger, migration 20261029090000); the status moves
// once, OPEN -> PAID (a verified payment) or OPEN -> VOID (with a reason).
// At most one OPEN invoice per store (partial unique index).
model Invoice {
  id      String @id @default(cuid())
  number  String @unique
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  plan        StorePlan
  interval    BillingInterval
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("PHP")
  periodStart DateTime
  periodEnd   DateTime
  dueAt       DateTime

  termsVersion Int
  termsBody    String
  acceptedById String
  acceptedBy   User     @relation("InvoiceAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)
  acceptedAt   DateTime

  status     InvoiceStatus @default(OPEN)
  paidAt     DateTime?
  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?         @relation("InvoiceVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason String?

  payments SubscriptionPayment[]

  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([status, dueAt])
  @@map("invoices")
}

// Notifications for platform administrators (no store). Deduplicated by
// key, so a scheduled job or page load can raise the same event safely.
// Every administrator is a recipient; whether each has read it is kept per
// administrator in platform_notification_reads (readAt/readById here are
// unused since migration 20261030090000 and kept only for history).
model PlatformNotification {
  id        String    @id @default(cuid())
  kind      String
  title     String
  body      String
  href      String?
  storeId   String?
  dedupeKey String    @unique
  readAt    DateTime?
  readById  String?
  createdAt DateTime  @default(now())

  reads PlatformNotificationRead[]

  @@index([readAt, createdAt])
  @@index([createdAt])
  @@map("platform_notifications")
}

// One administrator has read one platform notification. Written only for
// the signed-in administrator, so nobody can change another's read state.
model PlatformNotificationRead {
  notificationId String
  notification   PlatformNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation("PlatformNotificationReads", fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime             @default(now())

  @@id([notificationId, userId])
  @@index([userId])
  @@map("platform_notification_reads")
}

// ---------------------------------------------------------------------------
// Customer support
// ---------------------------------------------------------------------------

// A concern sent to the platform administrators, by a signed-in account (APP)
// or from the public Help page by someone who cannot sign in (PUBLIC).
//
// Reached only through src/server/support — never through a store client
// (MODEL_SCOPES marks these models denied), because support has to work for a
// suspended or read-only store too. The requester and store are always taken
// from the server session; a trigger (migration 20261031090000) keeps the
// store equal to the requester's, and the number, requester, store and source
// fixed once written.
model SupportTicket {
  id     String @id @default(cuid())
  // SUP-000123, from a database sequence, so two submissions at the same
  // instant can never share a number.
  number String @unique @default(dbgenerated("('SUP-'::text || lpad((nextval('support_ticket_number_seq'::regclass))::text, 6, '0'::text))"))

  source SupportSource

  // Empty for public submissions, and if the account is later deleted.
  requesterId   String?
  requester     User?   @relation("SupportRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  storeId       String?
  store         Store?  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  // Copied at submission, so the ticket still says who wrote it.
  requesterName String
  // Where a public requester asked to be answered. Empty for APP tickets.
  replyEmail    String?

  category SupportCategory
  subject  String
  status   SupportStatus   @default(NEW)
  priority SupportPriority @default(NORMAL)

  assignedToId String?
  assignedTo   User?   @relation("SupportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  // One per form submission, so a double click or a retried request stores
  // the ticket once.
  submissionKey String  @unique
  // Keyed hash of the submitter's IP, for abuse limits only. Never the IP.
  ipHash        String?

  lastActivityAt       DateTime  @default(now())
  lastAdminReplyAt     DateTime?
  lastRequesterReplyAt DateTime?
  // When the requester last opened the conversation; a newer admin reply is unread.
  requesterReadAt      DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?

  messages    SupportMessage[]
  attachments SupportAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, lastActivityAt])
  @@index([category])
  @@index([storeId])
  @@index([requesterId, lastActivityAt])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([replyEmail, createdAt])
  @@index([ipHash, createdAt])
  @@map("support_tickets")
}

// One entry in a ticket's conversation. Append-only (trigger). INTERNAL
// entries are administrator notes and are never returned to the requester;
// SYSTEM entries record status changes and other events.
model SupportMessage {
  id         String            @id @default(cuid())
  ticketId   String
  ticket     SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  authorId   String?
  author     User?             @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorKind SupportAuthorKind
  visibility SupportVisibility @default(PUBLIC)
  // Plain text. Rendered as text, never as HTML.
  body       String

  attachments SupportAttachment[]

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// A screenshot attached to a message. The file lives in a private bucket and
// is only ever handed out as a short-lived signed URL, after the same check
// that guards the conversation.
model SupportAttachment {
  id           String         @id @default(cuid())
  ticketId     String
  ticket       SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  messageId    String
  message      SupportMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  // Path inside the private bucket; a random name, never the uploaded one.
  storagePath  String         @unique
  originalName String
  // Taken from the file's own bytes, not from the browser.
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  uploadedBy   User?          @relation("SupportAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([messageId])
  @@map("support_attachments")
}

enum SupportSource {
  PUBLIC
  APP
}

enum SupportCategory {
  TECHNICAL_ISSUE
  BUG_REPORT
  FEATURE_REQUEST
  BILLING
  ACCOUNT_LOGIN
  INSTALLATION
  GENERAL
}

enum SupportStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportAuthorKind {
  REQUESTER
  ADMIN
  SYSTEM
}

enum SupportVisibility {
  PUBLIC
  INTERNAL
}

enum StorePlan {
  BASIC
  BUSINESS
  ENTERPRISE
}

enum StoreStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
}

// ---------------------------------------------------------------------------
// Identity & access control
// ---------------------------------------------------------------------------

model User {
  id String @id @default(cuid())

  // The store this account works in. Empty only for the platform's system
  // administrators, who hold no store permissions. Migration 20261023090000
  // keeps a user's store equal to their role's, and only the System
  // Administrator role has none.
  storeId            String?
  store              Store?    @relation("StoreMembers", fields: [storeId], references: [id], onDelete: Restrict)
  ownedStore         Store?    @relation("StoreOwner")
  name               String
  email              String    @unique
  // Sign-in name, stored trimmed and lowercase so uniqueness is
  // case-insensitive (a CHECK constraint in migration 20261020090000 holds
  // it to that form). `displayUsername` keeps the capitalisation as typed.
  username           String    @unique
  displayUsername    String?
  emailVerified      Boolean   @default(false)
  image              String?
  phone              String?
  isActive           Boolean   @default(true)
  lastLoginAt        DateTime?
  // Hash of the POS lock-screen PIN (same hasher as passwords). Optional: with
  // no PIN the lock screen asks for the account password.
  posPinHash         String?
  // Set by the server when an administrator chose this account's password
  // (a new store owner, or an owner password reset). While true, every page,
  // action and store query is refused except changing the password — see
  // `getCurrentUser`. Cleared only by that change, in the same transaction
  // that stores the new hash. Never accepted from client input.
  mustChangePassword Boolean   @default(false)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  sessions             Session[]
  accounts             Account[]
  auditLogs            AuditLog[]
  sales                Sale[]
  voidedSales          Sale[]                       @relation("SaleVoidedBy")
  inventoryTransaction InventoryTransaction[]
  returns              Return[]
  payments             Payment[]
  shifts               CashierShift[]               @relation("ShiftCashier")
  closedShifts         CashierShift[]               @relation("ShiftClosedBy")
  reviewedShifts       CashierShift[]               @relation("ShiftReviewedBy")
  cashMovements        CashMovement[]
  walletTransactions   WalletTransaction[]          @relation("WalletTransactionBy")
  reversedWallet       WalletTransaction[]          @relation("WalletTransactionReversedBy")
  shiftAdjustments     ShiftAdjustment[]
  readNotifications    Notification[]               @relation("NotificationReadBy")
  passkeys             Passkey[]
  recordedPayments     SubscriptionPayment[]        @relation("PaymentRecordedBy")
  voidedPayments       SubscriptionPayment[]        @relation("PaymentVoidedBy")
  verifiedPayments     SubscriptionPayment[]        @relation("PaymentVerifiedBy")
  rejectedPayments     SubscriptionPayment[]        @relation("PaymentRejectedBy")
  paymentReceipts      SubscriptionPaymentReceipt[] @relation("PaymentReceiptUploadedBy")
  acceptedInvoices     Invoice[]                    @relation("InvoiceAcceptedBy")
  voidedInvoices       Invoice[]                    @relation("InvoiceVoidedBy")
  platformReads        PlatformNotificationRead[]   @relation("PlatformNotificationReads")
  completedSetup       Installation[]               @relation("InstallationCompletedBy")
  supportTickets       SupportTicket[]              @relation("SupportRequester")
  assignedSupport      SupportTicket[]              @relation("SupportAssignee")
  supportMessages      SupportMessage[]             @relation("SupportMessageAuthor")
  supportAttachments   SupportAttachment[]          @relation("SupportAttachmentUploader")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([isActive])
  @@index([storeId])
  @@map("users")
}

model Role {
  id String @id @default(cuid())

  // Each store has its own copy of the built-in roles, so one owner editing
  // "Cashier" never changes another store's cashiers. Empty only for the
  // global System Administrator role.
  storeId     String?
  store       Store?  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name        String
  slug        String
  description String?
  isSystem    Boolean @default(false)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@unique([storeId, name])
  @@index([storeId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  // "products.create", "reports.view" — resource.action
  key         String  @unique
  resource    String
  action      String
  description String?

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Better Auth session/credential tables.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  // Set while the POS lock screen is up. A locked session stays signed in but
  // every page and server action refuses it until it is unlocked.
  lockedAt       DateTime?
  // Wrong PIN/password attempts on the lock screen since it was last unlocked.
  unlockFailures Int       @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// A WebAuthn passkey: the public half only. The private key never leaves the
// user's device or passkey provider, and no biometric data ever reaches the
// server — the device checks the face or fingerprint itself and signs.
model Passkey {
  id           String  @id @default(cuid())
  // Base64url credential id, as the authenticator reports it.
  credentialId String  @unique
  // COSE public key, base64url. Verifies each sign-in signature.
  publicKey    String
  // Signature counter; 0 for authenticators that do not keep one.
  counter      Int     @default(0)
  // Comma-separated WebAuthn transports (internal, hybrid, usb, …).
  transports   String?
  // 'singleDevice' or 'multiDevice' (synced, e.g. iCloud Keychain).
  deviceType   String
  backedUp     Boolean @default(false)
  // Authenticator model id; often all zeros for privacy.
  aaguid       String?
  // Shown in the profile so the owner can tell their devices apart.
  name         String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("passkeys")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId     String  @default(dbgenerated())
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name        String
  slug        String
  description String?
  isActive    Boolean @default(true)

  // Self-relation so categories can nest (Beverages > Soft Drinks).
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, name])
  @@unique([storeId, slug])
  @@index([parentId])
  @@index([storeId])
  @@map("categories")
}

model Product {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId     String  @default(dbgenerated())
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  sku         String
  barcode     String?
  name        String
  description String?
  imageUrl    String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // costPrice is the moving-average cost, recalculated on every stock-in.
  costPrice    Decimal @default(0) @db.Decimal(18, 4)
  sellingPrice Decimal @default(0) @db.Decimal(18, 4)

  minStock     Decimal @default(0) @db.Decimal(18, 3)
  maxStock     Decimal @default(0) @db.Decimal(18, 3)
  reorderLevel Decimal @default(0) @db.Decimal(18, 3)
  reorderQty   Decimal @default(0) @db.Decimal(18, 3)

  status      ProductStatus @default(ACTIVE)
  isTrackable Boolean       @default(true)

  // What the product is counted and sold in, and whether fractions of it may
  // be sold (0.5 kg, 1.5 m). Stock is stored in this unit, never converted.
  // A trigger (migration 20261106090000) refuses a fractional quantity on a
  // product that does not allow decimals. Existing products: PIECE, whole.
  unit          ProductUnit @default(PIECE)
  allowsDecimal Boolean     @default(false)

  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  saleItems             SaleItem[]
  returnItems           ReturnItem[]
  priceHistory          PriceHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@index([categoryId])
  @@index([status])
  @@index([name])
  @@index([storeId])
  @@map("products")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductUnit {
  PIECE
  PACK
  BOX
  BOTTLE
  SACK
  BAG
  KILOGRAM
  GRAM
  LITER
  MILLILITER
  METER
}

// Price changes are auditable and drive the "Price Changed" notification.
