// ---------------------------------------------------------------------------
// Stock
// ---------------------------------------------------------------------------

// One row per product per warehouse. `quantity` is on-hand; `reserved` is
// committed to unfulfilled orders. Available = quantity - reserved.
model Inventory {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId     String @default(dbgenerated())
  store       Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  productId   String
  warehouseId String

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  quantity Decimal @default(0) @db.Decimal(18, 3)
  reserved Decimal @default(0) @db.Decimal(18, 3)

  // Drives inventory-aging and dead-stock reports.
  lastReceivedAt DateTime?
  lastSoldAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@index([storeId])
  @@map("inventory")
}

// Append-only stock ledger. Every movement in the system lands here.
model InventoryTransaction {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId     String @default(dbgenerated())
  store       Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  productId   String
  warehouseId String

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  type InventoryTransactionType

  // Signed: positive adds stock, negative removes it.
  quantity      Decimal @db.Decimal(18, 3)
  balanceBefore Decimal @db.Decimal(18, 3)
  balanceAfter  Decimal @db.Decimal(18, 3)
  // Unit cost at the moment of the movement — used for COGS and stock value.
  unitCost      Decimal @default(0) @db.Decimal(18, 4)

  // Polymorphic pointer back to whatever caused the movement.
  referenceType ReferenceType?
  referenceId   String?
  note          String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([type, createdAt])
  @@index([referenceType, referenceId])
  @@index([storeId, createdAt])
  @@map("inventory_transactions")
}

enum InventoryTransactionType {
  STOCK_IN
  SALE
  SALE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  OPENING_BALANCE
}

enum ReferenceType {
  SALE
  RETURN
  ADJUSTMENT
}

// ---------------------------------------------------------------------------
// Cashier shifts
// ---------------------------------------------------------------------------

// One shift per cashier session. Opens with a counted starting float, closes
// with a counted cash total; the difference is the till variance. Totals are
// computed live while the shift is open, then frozen onto this row at close
// so a later void/return can never silently rewrite a reconciled shift.
model CashierShift {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId String @default(dbgenerated())
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  userId  String
  user    User   @relation("ShiftCashier", fields: [userId], references: [id], onDelete: Restrict)

  status       ShiftStatus @default(OPEN)
  openedAt     DateTime    @default(now())
  openingCash  Decimal     @db.Decimal(18, 4)
  // Denominations, coins for change, anything noticed when counting the float.
  openingNotes String?

  closedAt         DateTime?
  expectedCash     Decimal?  @db.Decimal(18, 4)
  actualCash       Decimal?  @db.Decimal(18, 4)
  difference       Decimal?  @db.Decimal(18, 4)
  totalSales       Decimal?  @db.Decimal(18, 4)
  transactionCount Int?
  // The parts of expectedCash, frozen at close alongside it.
  cashSales        Decimal?  @db.Decimal(18, 4)
  cashRefunds      Decimal?  @db.Decimal(18, 4)
  cashIn           Decimal?  @db.Decimal(18, 4)
  cashOut          Decimal?  @db.Decimal(18, 4)
  // Net drawer cash from GCash cash-in / cash-out services (amounts and fees),
  // frozen at close. Null for shifts closed before migration 20261107090000.
  walletCash       Decimal?  @db.Decimal(18, 4)
  // Who closed it: the cashier, or the owner closing a shift left open.
  closedById       String?
  closedBy         User?     @relation("ShiftClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  // Closing notes.
  notes String?

  // Human-facing reference, shown as SH-000123. Assigned by the database.
  number Int @unique @default(autoincrement())

  // Owner review of a closed shift whose count missed the expected cash by
  // more than the tolerance. Reviewing records who looked and what they
  // concluded; it never changes the count or the variance above.
  reviewStatus ShiftReviewStatus @default(NOT_REQUIRED)
  reviewedById String?
  reviewedBy   User?             @relation("ShiftReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  sales         Sale[]
  payments      Payment[]
  movements     CashMovement[]
  walletTransactions WalletTransaction[]
  adjustments   ShiftAdjustment[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Also, from the migrations: a partial unique index allows one OPEN shift
  // per cashier, and a trigger refuses changes to a closed shift's figures.
  @@index([userId, status])
  @@index([status])
  @@index([closedAt])
  @@index([reviewStatus])
  @@index([storeId, status])
  @@map("cashier_shifts")
}

enum ShiftReviewStatus {
  // Open, or closed within the tolerance.
  NOT_REQUIRED
  // Closed short or over; waiting for the owner.
  PENDING
  REVIEWED
}

// A correction to a closed shift's reconciliation, made by the owner — money
// found later, a miscount confirmed. Signed: positive adds to the counted
// cash, negative takes from it. Kept beside the original figures rather than
// rewriting them, and append-only (a trigger refuses updates and deletes).
model ShiftAdjustment {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId String       @default(dbgenerated())
  store   Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  shiftId String
  shift   CashierShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  amount  Decimal      @db.Decimal(18, 4)
  reason  String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([shiftId])
  @@index([storeId])
  @@map("shift_adjustments")
}

// In-app notices for the owner. One shared inbox: anyone holding the
// financial permission sees them. `dedupeKey` is unique, so a retried request
// or a repeated poll cannot raise the same notice twice.
model Notification {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId   String           @default(dbgenerated())
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  type      NotificationType
  title     String
  body      String
  href      String?
  dedupeKey String

  shiftId String?
  shift   CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  readAt   DateTime?
  readById String?
  readBy   User?     @relation("NotificationReadBy", fields: [readById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([storeId, dedupeKey])
  @@index([readAt, createdAt])
  @@index([createdAt])
  @@index([storeId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  BILLING_REMINDER
  INVOICE_CREATED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  PAYMENT_SUBMITTED
  SUPPORT_REPLY
  SHIFT_OPENED
  SHIFT_CLOSED
  SHIFT_SHORTAGE
  SHIFT_OVERAGE
  SHIFT_OVERDUE
}

// Cash put into or taken out of a drawer during a shift for anything other
// than a sale or refund — more change, a supplier paid from the till, a bank
// drop. Append-only: a mistake is corrected with an opposite movement.
model CashMovement {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId String           @default(dbgenerated())
  store   Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  shiftId String
  shift   CashierShift     @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  type    CashMovementType
  // Always positive; `type` gives the direction.
  amount  Decimal          @db.Decimal(18, 4)
  reason  String

  // Shown as CO-000123 (cash out) or CI-000123 (cash in). From a sequence.
  number   Int                  @unique @default(autoincrement())
  category CashMovementCategory @default(OTHER)
  // A longer explanation, beyond the one-line reason.
  notes    String?

  // A correction reverses exactly one earlier movement, at most once; a
  // CHECK keeps category CORRECTION and this link together.
  correctsId  String?       @unique
  corrects    CashMovement? @relation("CashMovementCorrection", fields: [correctsId], references: [id], onDelete: Restrict)
  correctedBy CashMovement? @relation("CashMovementCorrection")

  // One per attempt, so a doubled submit records the movement once.
  clientRequestId String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([storeId, clientRequestId])
  @@index([shiftId])
  @@index([storeId])
  @@index([storeId, createdAt])
  @@index([userId, createdAt])
  @@map("cash_movements")
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
}

// A GCash cash-in or cash-out service for a customer: the store acts as an
// agent, moving money between its drawer and its own GCash account. Not a
// product sale; only the service fee is revenue.
//
//   CASH_IN   customer pays cash (amount + fee); the store sends `amount`
//             from its GCash. Drawer +amount +fee, wallet -amount.
//   CASH_OUT  customer sends `amount` to the store's GCash; the store hands
//             back amount - fee in cash. Drawer -amount +fee, wallet +amount.
//
// Append-only: a mistake is reversed once, with a reason, while the shift is
// still open (trigger, migration 20261107090000). A reversed entry no longer
// counts anywhere. There is no connection to GCash itself: the cashier
// records what happened in the store's GCash app.
model WalletTransaction {
  id String @id @default(cuid())

  storeId String                @default(dbgenerated())
  store   Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  // Shown as GC-000123.
  number  Int                   @unique @default(autoincrement())
  type    WalletTransactionType
  channel String                @default("GCASH")
  // What moves through GCash. Always positive.
  amount  Decimal               @db.Decimal(18, 4)
  // The store's service fee, typed in by the cashier; collected in cash.
  fee     Decimal               @default(0) @db.Decimal(18, 4)
  // The GCash reference, normalised. One live entry per reference per store.
  reference String
  // Only the last four digits of the customer's number, if given.
  customerMobileLast4 String?
  notes               String?

  shiftId String
  shift   CashierShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  userId  String
  user    User         @relation("WalletTransactionBy", fields: [userId], references: [id], onDelete: Restrict)

  reversedAt     DateTime?
  reversedById   String?
  reversedBy     User?     @relation("WalletTransactionReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  reversalReason String?

  clientRequestId String?

  createdAt DateTime @default(now())

  @@unique([storeId, clientRequestId])
  @@index([storeId, createdAt])
  @@index([shiftId])
  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

enum WalletTransactionType {
  CASH_IN
  CASH_OUT
}

enum CashMovementCategory {
  CHANGE_FUND
  OWNER_TOP_UP
  SUPPLIER_PAYMENT
  EXPENSE
  BANK_DEPOSIT
  OWNER_WITHDRAWAL
  CORRECTION
  OTHER
}

enum ShiftStatus {
  OPEN
  CLOSED
}

