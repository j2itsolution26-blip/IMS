model Sale {
  id String @id @default(cuid())

  // Owning store. Filled in by the store-scoped client (src/lib/tenant), never
  // by hand; the column has no database default, so a row the client failed
  // to tag is rejected rather than silently filed under some store.
  storeId       String @default(dbgenerated())
  store         Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  invoiceNumber String

  warehouseId String
  userId      String
  shiftId     String?

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  shift     CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  status  SaleStatus  @default(COMPLETED)
  channel SaleChannel @default(POS)

  subtotal     Decimal @default(0) @db.Decimal(18, 4)
  taxAmount    Decimal @default(0) @db.Decimal(18, 4)
  discount     Decimal @default(0) @db.Decimal(18, 4)
  total        Decimal @default(0) @db.Decimal(18, 4)
  paidAmount   Decimal @default(0) @db.Decimal(18, 4)
  changeAmount Decimal @default(0) @db.Decimal(18, 4)
  // Sum of (unitCost * qty) frozen at sale time, so profit never drifts when
  // product cost changes later.
  costOfGoods  Decimal @default(0) @db.Decimal(18, 4)

  notes String?

  // One id per checkout attempt, made by the till, so a retried or doubled
  // request records the sale once (migration 20261103090000). Empty for
  // sales from before it, which never collide (NULLs are distinct).
  clientRequestId String?

  // Set together when the sale is voided (CHECK, migration 20261104090000).
  // The sale row itself is never deleted.
  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("SaleVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason String?

  items    SaleItem[]
  payments Payment[]
  returns  Return[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, invoiceNumber])
  @@unique([storeId, clientRequestId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status])
  @@index([shiftId])
  @@index([storeId, createdAt])
  @@map("sales")
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
  VOIDED
}

enum SaleChannel {
